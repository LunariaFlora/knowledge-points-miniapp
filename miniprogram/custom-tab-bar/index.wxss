.tabbar {
  height: calc(124rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: #ffffff;
  border-top: 2rpx solid #eceef1;
  box-shadow: 0 -4rpx 16rpx rgba(40,50,47,.03);
}
.tab-item {
  height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e9194;
  background: #ffffff;
}
.tab-item::after { border: 0; }
.tab-item.active { color: #13b98c; }
.tab-icon { height: 58rpx; font-size: 53rpx; line-height: 56rpx; font-weight: 900; }
.gift-icon { font-size: 46rpx; filter: hue-rotate(105deg) saturate(.7); }
.user-icon { font-size: 44rpx; filter: grayscale(1); }
.active .user-icon { filter: none; }
.tab-label { font-size: 23rpx; }
