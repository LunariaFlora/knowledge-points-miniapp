<view wx:if="{{!hidden}}" class="tabbar">
  <button wx:for="{{tabs}}" wx:key="path" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" data-path="{{item.path}}" bindtap="switchTab">
    <text class="tab-icon {{item.iconClass}}">{{item.icon}}</text>
    <text class="tab-label">{{item.label}}</text>
  </button>
</view>
