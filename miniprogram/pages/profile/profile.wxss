.profile-page { min-height: 100vh; padding-bottom: calc(146rpx + env(safe-area-inset-bottom)); }
.profile-hero { min-height: 210rpx; padding: 40rpx 40rpx 74rpx; display: flex; align-items: center; gap: 24rpx; color: #fff; background: radial-gradient(circle at 15% 15%,rgba(255,255,255,.26),transparent 33%),linear-gradient(135deg,#28cbb0,#0c9275); box-shadow: 0 18rpx 42rpx rgba(12,146,117,.17); }
.avatar { width: 92rpx; height: 92rpx; flex: none; display: flex; align-items: center; justify-content: center; color: #0aaa51; background: #fff; border-radius: 50%; font-family: STKaiti,KaiTi,serif; font-size: 40rpx; font-weight: 800; }
.profile-hero>view:last-child { display: flex; flex-direction: column; }.profile-name { font-size: 46rpx; font-weight: 800; }.profile-copy { margin-top: 9rpx; color: rgba(255,255,255,.94); font-size: 30rpx; }
.profile-metrics { margin: -40rpx 26rpx 22rpx; position: relative; display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; background: #fff; border-radius: 26rpx; box-shadow: 0 12rpx 32rpx rgba(36,46,43,.08); }
.profile-metrics button { height: 165rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; }.profile-metrics button+button { border-left: 2rpx solid #e4eeeb; }.profile-metrics button text:first-child { color: #0c9d7c; font-size: 48rpx; font-weight: 800; }.profile-metrics button text:last-child { margin-top: 9rpx; color: #586c66; font-size: 29rpx; }
.profile-menu { margin: 31rpx 28rpx; overflow: hidden; background: #fff; border-radius: 28rpx; box-shadow: 0 12rpx 32rpx rgba(18,114,94,.07); }.profile-menu button { width: 100%; min-height: 124rpx; padding: 0 31rpx; display: grid; grid-template-columns: 55rpx 1fr 37rpx; align-items: center; background: #fff; font-size: 31rpx; }.profile-menu button+button { border-top: 2rpx solid #e7efed; }
.menu-icon { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; color: #0f9f79; background: #e5faf4; border-radius: 12rpx; font-size: 25rpx; font-weight: 800; }.arrow { color: #aebcb8; font-size: 46rpx; }.phone { color: #0f9f79; }.phone-muted { color: #8c9a96; font-size: 27rpx; }
