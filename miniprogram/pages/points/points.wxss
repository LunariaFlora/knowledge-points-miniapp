.points-page { min-height: 100vh; }.filter-tabs { height: 96rpx; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border-bottom: 2rpx solid #e3ece9; }.filter-tabs button { box-sizing: border-box; position: relative; min-height: 96rpx; padding: 0; display: flex; align-items: center; justify-content: center; color: #667873; background: #fff; font-size: 26rpx; line-height: 1; text-align: center; }.filter-tabs button.active { color: #0f9f79; font-weight: 700; }.filter-tabs button.active::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 60rpx; height: 5rpx; background: #16b98d; border-radius: 5rpx; transform: translateX(-50%); }
.ledger-list { padding: 24rpx; display: grid; gap: 20rpx; }.ledger-row { padding: 29rpx; display: grid; grid-template-columns: 1fr auto; align-items: center; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(18,114,94,.06); }.ledger-row>view { display: flex; flex-direction: column; }.ledger-title { font-size: 31rpx; font-weight: 800; }.ledger-copy,.ledger-time { margin-top: 9rpx; color: #7e8d89; font-size: 24rpx; }.ledger-amount { color: #10aa80; font-size: 35rpx; font-weight: 800; }.ledger-amount.minus { color: #df655f; }
