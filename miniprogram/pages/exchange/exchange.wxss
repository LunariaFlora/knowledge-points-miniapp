.exchange-page { min-height: 100vh; padding: 27rpx 0 calc(146rpx + env(safe-area-inset-bottom)); }
.balance-card { min-height: 216rpx; margin: 0 28rpx 27rpx; display: grid; grid-template-columns: 1fr 1fr; align-items: center; color: #fff; background: radial-gradient(circle at 18% 10%,rgba(255,255,255,.28),transparent 34%),radial-gradient(circle at 88% 82%,rgba(72,238,202,.25),transparent 34%),linear-gradient(135deg,#28cbb0,#0d8d73); border-radius: 30rpx; box-shadow: 0 18rpx 42rpx rgba(13,141,115,.20); }
.balance-card>view { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }.balance-card>view+view { border-left: 2rpx solid rgba(255,255,255,.42); }
.balance-value { font-size: 59rpx; font-weight: 800; }.balance-label { font-size: 31rpx; color: rgba(255,255,255,.95); }
.exchange-heading { display: block; padding: 13rpx 33rpx 20rpx; font-size: 40rpx; font-weight: 800; }
.exchange-list { padding: 0 26rpx; display: grid; gap: 20rpx; }
.exchange-item { min-height: 232rpx; display: grid; grid-template-columns: 220rpx 1fr 148rpx; align-items: center; overflow: hidden; background: #fff; border-radius: 28rpx; box-shadow: 0 14rpx 34rpx rgba(18,114,94,.09); }
.exchange-item>image { width: 210rpx; height: 212rpx; }.exchange-info { min-width: 0; padding: 20rpx; display: flex; flex-direction: column; }
.gift-name { overflow: hidden; font-size: 35rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.gift-market { margin-top: 11rpx; color: #687c76; font-size: 28rpx; }.gift-points { margin-top: 26rpx; color: #0f9f79; font-size: 37rpx; font-weight: 800; }
.redeem-state { min-width: 128rpx; min-height: 84rpx; justify-self: center; display:flex; align-items:center; justify-content:center; padding: 13rpx 20rpx; color: #fff; background: linear-gradient(135deg,#2acdaf,#0d9275); border-radius: 42rpx; box-shadow: 0 8rpx 20rpx rgba(13,146,117,.17); font-size: 29rpx; font-weight: 800; }.redeem-state.disabled { color: #71817c; background: #e8efed; box-shadow: none; }
.modal-root { position: fixed; inset: 0; z-index: 1000; }.modal-mask { position: absolute; inset: 0; background: rgba(0,0,0,.56); }
.product-sheet { box-sizing: border-box; position: absolute; left: 30rpx; right: 30rpx; top: 28rpx; bottom: calc(28rpx + env(safe-area-inset-bottom)); padding: 24rpx 30rpx 44rpx; overflow-y: auto; background: #fff; border-radius: 30rpx; }
.modal-close { position: absolute; right: 18rpx; top: 18rpx; z-index: 4; width: 68rpx; height: 68rpx; padding: 0; display: flex; align-items: center; justify-content: center; color: #40544e; background: rgba(255,255,255,.96); border: 2rpx solid #d7e4df; border-radius: 50%; box-shadow: 0 6rpx 18rpx rgba(18,80,63,.12); font-size: 48rpx; line-height: 1; }
.detail-swiper { width: 100%; height: 590rpx; border-radius: 22rpx; overflow: hidden; }.detail-image { width: 100%; height: 590rpx; border-radius: 22rpx; }.pager-dot { float: right; margin: -54rpx 12rpx 0 0; padding: 6rpx 14rpx; position: relative; z-index: 2; color: #fff; background: rgba(0,0,0,.5); border-radius: 20rpx; font-size: 22rpx; }
.detail-name { display: block; margin-top: 46rpx; font-size: 42rpx; font-weight: 800; }.detail-price { margin-top: 22rpx; display: grid; grid-template-columns: 1fr auto; }.detail-market { color: #89958f; text-decoration: line-through; }.detail-points { grid-column: 1; margin-top: 9rpx; color: #0f9f79; font-size: 48rpx; font-weight: 800; }.detail-stock { grid-column: 2; grid-row: 1/3; align-self: end; color: #10a982; }
.detail-description { display: block; margin: 28rpx 0 46rpx; color: #666; line-height: 1.7; }.primary-action { width: 100%; height: 86rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#10cf68,#08ad56); border-radius: 44rpx; font-size: 28rpx; font-weight: 800; }.primary-action[disabled] { color: #999; background: #e7e7e7; }
.pickup-sheet { box-sizing: border-box; position: absolute; left: 0; right: 0; bottom: 0; max-height: calc(100vh - 72rpx); padding: 18rpx 34rpx calc(46rpx + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; background: #fff; border-radius: 36rpx 36rpx 0 0; }.pickup-sheet .modal-close { top: 16rpx; right: 26rpx; }.sheet-grabber { width: 76rpx; height: 8rpx; margin: 0 auto 20rpx; background: #ddd; border-radius: 6rpx; }.pickup-title { display: block; text-align: center; font-size: 34rpx; font-weight: 800; }
.selected-gift { margin-top: 24rpx; padding: 14rpx; display: flex; gap: 18rpx; align-items: center; background: #f2f8f6; border-radius: 18rpx; }.selected-gift image { width: 126rpx; height: 104rpx; border-radius: 12rpx; }.selected-gift view { display: flex; flex-direction: column; gap: 10rpx; }.selected-gift view text:last-child { color: #0f9f79; }
.field-label { display: block; margin-top: 20rpx; color: #526761; font-size: 25rpx; }.field-box { box-sizing: border-box; width: 100%; height: 82rpx; margin-top: 9rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid #cfe0db; border-radius: 16rpx; }
.consent-row { min-height: 76rpx; margin: 20rpx 0; display: flex; align-items: center; gap: 16rpx; color: #45494d; font-size: 27rpx; line-height: 1.6; }.consent-row checkbox { transform: scale(1.05); }.pickup-tip { display: block; margin-bottom: 16rpx; color: #686d72; font-size: 24rpx; text-align: center; }
