.records-page { min-height: 100vh; }.filter-tabs { height: 96rpx; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border-bottom: 2rpx solid #e3ece9; }.filter-tabs button { box-sizing: border-box; position: relative; min-height: 96rpx; padding: 0; display: flex; align-items: center; justify-content: center; color: #667873; background: #fff; font-size: 26rpx; line-height: 1; text-align: center; }.filter-tabs button.active { color: #0f9f79; font-weight: 700; }.filter-tabs button.active::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 60rpx; height: 5rpx; background: #16b98d; border-radius: 5rpx; transform: translateX(-50%); }
.record-list { padding: 24rpx; display: grid; gap: 20rpx; }.record-row { padding: 29rpx; display: grid; grid-template-columns: minmax(0,1fr) auto; gap:20rpx;align-items: start; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(18,114,94,.06); }.record-main { min-width:0;display:flex;flex-direction:column; }.record-name { font-size: 34rpx; font-weight: 800;line-height:1.45 }.record-copy { margin-top: 9rpx; color: #7e8d89; font-size: 25rpx;line-height:1.5 }.voucher-label{margin-top:22rpx;color:#5c716b;font-size:25rpx}.voucher { margin-top:8rpx;color:#173f37;font-size:36rpx;font-weight:800;letter-spacing:2rpx;word-break:break-all }.voucher-actions{margin-top:20rpx;display:flex;flex-wrap:wrap;gap:14rpx}.voucher-actions button{min-height:72rpx;padding:12rpx 22rpx;display:flex;align-items:center;justify-content:center;color:#0b8e71;background:#e8f8f3;border:2rpx solid #c9eee3;border-radius:36rpx;font-size:27rpx;font-weight:700}.voucher-actions .primary-voucher{color:#fff;background:linear-gradient(135deg,#2acbad,#0b9073);border-color:transparent}.record-status { flex:none;padding: 9rpx 15rpx; border-radius: 24rpx; font-size: 23rpx; }.record-status.pending { color: #0c8066; background: #e5f8f2; }.record-status.complete { color: #098867; background: #def8ef; }.record-status.closed { color: #71817c; background: #e8efed; }.cancel-button { align-self:flex-start;margin-top: 24rpx; color: #c9534e; font-size: 26rpx; }
.voucher-modal{position:fixed;inset:0;z-index:1000}.voucher-mask{position:absolute;inset:0;background:rgba(0,0,0,.62)}.voucher-card{box-sizing:border-box;position:absolute;left:44rpx;right:44rpx;top:50%;padding:52rpx 38rpx 42rpx;display:flex;flex-direction:column;align-items:center;text-align:center;background:#fff;border-radius:32rpx;box-shadow:0 24rpx 70rpx rgba(0,55,44,.28);transform:translateY(-50%)}.modal-close{position:absolute;right:18rpx;top:18rpx;width:68rpx;height:68rpx;padding:0;display:flex;align-items:center;justify-content:center;color:#40544e;background:#f2f7f5;border:2rpx solid #d7e4df;border-radius:50%;font-size:48rpx;line-height:1}.voucher-title{color:#153f36;font-size:43rpx;font-weight:800}.voucher-gift{margin-top:14rpx;color:#60736e;font-size:29rpx}.voucher-qr{width:390rpx;height:390rpx;margin-top:24rpx}.qr-loading{width:390rpx;height:390rpx;margin-top:24rpx;display:flex;align-items:center;justify-content:center;color:#70807b;background:#f2f7f5;border-radius:24rpx;font-size:28rpx}.voucher-large{margin-top:18rpx;color:#0b8e71;font-size:40rpx;font-weight:800;letter-spacing:3rpx;word-break:break-all}.voucher-store{margin-top:18rpx;color:#3e5751;font-size:28rpx;line-height:1.65}.copy-large{min-width:300rpx;min-height:84rpx;margin-top:22rpx;padding:14rpx 32rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(135deg,#2acbad,#0b9073);border-radius:42rpx;font-size:29rpx;font-weight:800}.voucher-warning{margin-top:22rpx;color:#75847f;font-size:24rpx;line-height:1.65}
