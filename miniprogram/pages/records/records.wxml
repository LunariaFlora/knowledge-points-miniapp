<view class="records-page">
  <view class="filter-tabs"><button wx:for="{{filters}}" wx:key="value" class="{{activeFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeFilter">{{item.label}}</button></view>
  <view wx:if="{{loading}}" class="page-loading">正在加载领取记录…</view><view wx:elif="{{!filteredItems.length}}" class="empty-state">暂无领取记录</view>
  <view wx:else class="record-list"><view wx:for="{{filteredItems}}" wx:key="id" class="record-row"><view class="record-main"><text class="record-name">{{item.gift_name}}</text><text class="record-copy">{{item.store_name}} · {{item.request_no}}</text><text class="voucher-label">到店领取码</text><text class="voucher">{{item.voucher_code}}</text><view class="voucher-actions"><button data-code="{{item.voucher_code}}" bindtap="copyVoucher">复制领取码</button><button class="primary-voucher" data-id="{{item.id}}" bindtap="showVoucher">出示核销二维码</button></view><button wx:if="{{item.canCancel}}" class="cancel-button" data-id="{{item.id}}" bindtap="cancelPickup">取消申请并退回积分</button></view><text class="record-status {{item.statusClass}}">{{item.statusLabel}}</text></view></view>
</view>

<view wx:if="{{voucherVisible}}" class="voucher-modal"><view class="voucher-mask" catchtap="hideVoucher"></view><view class="voucher-card"><button class="modal-close" bindtap="hideVoucher">×</button><text class="voucher-title">到店核销凭证</text><text class="voucher-gift">{{activeVoucher.gift_name}}</text><view wx:if="{{voucherLoading}}" class="qr-loading">正在生成二维码…</view><image wx:elif="{{activeVoucher.dataUrl}}" class="voucher-qr" src="{{activeVoucher.dataUrl}}" mode="aspectFit" /><text class="voucher-large">{{activeVoucher.voucher_code}}</text><text class="voucher-store">请向 {{activeVoucher.store_name}} 工作人员出示二维码或领取码</text><button class="copy-large" data-code="{{activeVoucher.voucher_code}}" bindtap="copyVoucher">复制领取码</button><text class="voucher-warning">工作人员仍需登录后台核对状态并确认核销；扫码不会自动扣减库存。</text></view></view>
