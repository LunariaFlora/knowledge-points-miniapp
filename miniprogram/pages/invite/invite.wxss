.invite-page { min-height: 100vh; padding: 29rpx 29rpx 50rpx; }.invite-panel { padding: 54rpx 38rpx 42rpx; display: flex; flex-direction: column; align-items: center; color: #fff; text-align: center; background: radial-gradient(circle at 18% 10%,rgba(255,255,255,.25),transparent 34%),linear-gradient(135deg,#2acbb0,#0c8b72); border-radius: 31rpx; box-shadow: 0 18rpx 42rpx rgba(12,139,114,.18); }.invite-title { font-size: 48rpx; font-weight: 800; }.invite-copy { margin: 22rpx 0 25rpx; color: rgba(255,255,255,.96); font-size: 31rpx; line-height: 1.75; }.invite-code-strip { width:100%;box-sizing:border-box;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:rgba(255,255,255,.16);border:2rpx solid rgba(255,255,255,.24);border-radius:22rpx;font-size:29rpx; }.invite-code-strip text:last-child{font-size:37rpx;font-weight:800;letter-spacing:3rpx}.invite-help{margin:16rpx 2rpx 24rpx;color:rgba(255,255,255,.9);font-size:27rpx;line-height:1.7}.invite-stats { width: 100%; padding: 26rpx 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 2rpx solid rgba(255,255,255,.28); }.invite-stats>view{display:flex;flex-direction:column;align-items:center;gap:8rpx}.invite-stats>view+view{border-left:2rpx solid rgba(255,255,255,.25)}.stat-value{font-size:52rpx;font-weight:800}.stat-label{font-size:29rpx}.poster-trigger { min-width:320rpx;min-height:94rpx;margin-top: 13rpx;padding: 16rpx 36rpx;display:flex;align-items:center;justify-content:center;color: #0c8b72;background: #fff;border-radius: 48rpx;box-shadow: 0 8rpx 20rpx rgba(0,91,75,.16);font-size: 31rpx;font-weight: 800;text-align:center; }
.invite-list-title { display: block; margin: 40rpx 8rpx 20rpx; font-size: 36rpx; font-weight: 800; }.invite-list { display: grid; gap: 16rpx; }.invite-row { min-height:90rpx;padding: 25rpx 27rpx; display: flex;align-items:center; justify-content: space-between;gap:20rpx; background: #fff; border-radius: 22rpx;font-size:31rpx; }.invite-row text:last-child { flex:none;color: #667a74; font-size: 27rpx; }.empty-state{font-size:32rpx}
.poster-modal { position: fixed; inset: 0; z-index: 1000; }.poster-mask { position: absolute; inset: 0; background: rgba(0,0,0,.62); }.invite-poster { position: absolute; left: 46rpx; right: 46rpx; top: 96rpx; padding: 56rpx 38rpx 44rpx; display: flex; flex-direction: column; align-items: center; color: #fff; text-align: center; background: radial-gradient(circle at 18% 10%,rgba(255,255,255,.22),transparent 35%),linear-gradient(160deg,#20bea4,#08745f); border: 14rpx solid #fff; border-radius: 30rpx; box-shadow: 0 20rpx 50rpx rgba(0,63,52,.30); }.modal-close { position:absolute;right:-22rpx;top:-74rpx;width:68rpx;height:68rpx;padding:0;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(20,47,41,.9);border:2rpx solid rgba(255,255,255,.55);border-radius:50%;font-size:48rpx;line-height:1; }.poster-brand { font-family: STKaiti,KaiTi,serif; font-size: 44rpx; }.poster-title { margin: 33rpx 0; color: #e9fff9; font-size: 54rpx; font-weight: 800; text-shadow: 0 4rpx 12rpx rgba(0,74,61,.28); white-space: pre-line; }.code-card { width: 330rpx; padding: 30rpx; display: flex; flex-direction: column; gap: 13rpx; color: #0c8f7b; background: #fff; border-radius: 22rpx; }.code-card text:first-child{font-size:28rpx}.code-card text:last-child { font-size: 44rpx; font-weight: 800; letter-spacing: 4rpx; }.poster-tip { margin-top: 27rpx; font-size: 28rpx; line-height: 1.7; }.share-poster { min-width:300rpx;min-height:88rpx;margin-top: 26rpx; padding: 18rpx 37rpx;display:flex;align-items:center;justify-content:center;color: #0c8f7b; background: #fff; border-radius: 44rpx; font-size: 31rpx; font-weight: 800;text-align:center; }
.mini-code-image { width: 290rpx; height: 290rpx; padding: 14rpx; background: #fff; border-radius: 20rpx; }
