.home-page { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.health-banner { width: 100%; min-height: 320rpx; padding: 46rpx 40rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: radial-gradient(circle at 18% 12%, rgba(255,255,255,.28), transparent 30%), radial-gradient(circle at 85% 80%, rgba(62,238,199,.22), transparent 32%), linear-gradient(135deg, #27cbb1, #108f79); box-shadow: 0 18rpx 46rpx rgba(14,143,121,.18); }
.health-banner-active { opacity: .94; }
.banner-title { font-family: STKaiti, KaiTi, serif; font-size: 60rpx; font-weight: 800; letter-spacing: 5rpx; text-shadow: 0 4rpx 10rpx rgba(0,0,0,.16); }
.watch-action { min-width: 500rpx; margin-top: 40rpx; padding: 22rpx 38rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: radial-gradient(circle at 18% 10%, rgba(255,255,255,.24), transparent 38%), linear-gradient(135deg,#16c8a9,#087b68); border: 3rpx solid rgba(5,109,91,.72); border-radius: 26rpx; box-shadow: 0 16rpx 34rpx rgba(0,81,67,.30), inset 0 2rpx rgba(255,255,255,.42); font-size: 44rpx; font-weight: 800; }
.play-dot { width: 62rpx; height: 62rpx; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; background: #55e7c9; border-radius: 50%; box-shadow: 0 6rpx 16rpx rgba(0,94,79,.22); font-size: 28rpx; }
.section-copy { padding: 28rpx 30rpx 20rpx; }
.section-title, .section-subtitle, .gift-name, .market-price, .points-price { display: block; }
.section-title { font-size: 40rpx; font-weight: 800; }
.section-subtitle { margin-top: 8rpx; color: #6f807b; font-size: 27rpx; }
.gift-grid { padding: 0 26rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.gift-tile { overflow: hidden; padding-bottom: 26rpx; background: #fff; border-radius: 26rpx; box-shadow: 0 12rpx 30rpx rgba(21,116,96,.08); }
.gift-tile-active { opacity: .9; transform: scale(.99); }
.image-wrap { height: 282rpx; margin: 14rpx; position: relative; overflow: hidden; background: #eef1f0; border-radius: 16rpx; }
.gift-image { width: 100%; height: 100%; display: block; }
.market-badge { position: absolute; right: 10rpx; top: 10rpx; padding: 6rpx 12rpx; color: #e20c2d; background: rgba(255,255,255,.92); border-radius: 16rpx; font-size: 21rpx; font-weight: 800; }
.gift-name { margin: 2rpx 20rpx 0; overflow: hidden; color: #123b35; font-size: 31rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.market-price { margin: 8rpx 20rpx 0; color: #88958f; font-size: 24rpx; text-decoration: line-through; }
.points-price { margin: 4rpx 20rpx 0; color: #0f9f79; font-size: 31rpx; font-weight: 800; }
